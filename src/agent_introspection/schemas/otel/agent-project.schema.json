{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-project-otel",
  "version": 2,
  "scope": "span",
  "attributes": {
    "id": {
      "key": "agent.project.id",
      "type": "string",
      "required": true
    },
    "name": {
      "key": "agent.project.name",
      "type": "string",
      "required": true
    },
    "root": {
      "key": "agent.project.root",
      "type": "string",
      "required": true,
      "format": "normalized-absolute-path"
    },
    "kind": {
      "key": "agent.project.kind",
      "type": "string",
      "required": true,
      "enum": ["git", "non_git"]
    }
  },
  "metadata_states": ["absent", "complete", "invalid"],
  "tuple_requirements": {
    "same_span": true,
    "same_trace": true,
    "conflicts_invalid": true
  },
  "dashboard_attributes": {
    "id": "agent.project.id",
    "name": "agent.project.name",
    "paired": true
  },
  "derived_attribution": {
    "allowed_sources": [
      "complete_span_tuple",
      "immutable_session_context",
      "git_validated_tool_workspace"
    ],
    "git_validated_tool_workspace": {
      "field_scope": "tool_invocation",
      "requires": [
        "absolute_path",
        "configured_project_collection",
        "resolved_git_root",
        "single_project_closed_interval"
      ]
    }
  },
  "prohibited_attribution_sources": [
    "process_cwd",
    "project_alias",
    "unvalidated_path",
    "prompt_content",
    "thread_inference"
  ]
}
