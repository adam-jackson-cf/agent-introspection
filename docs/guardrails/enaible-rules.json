{
  "schema_version": 1,
  "rules": [
    {
      "id": "FANOUT.general",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "count": "distinct_non_stdlib_architectural_imports",
        "max_non_stdlib_dependencies": 10
      },
      "summary": "Bound non-stdlib architectural imports."
    },
    {
      "id": "FANOUT.large-module",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "nloc_over": 800,
        "count": "distinct_non_stdlib_architectural_imports",
        "max_non_stdlib_dependencies": 3
      },
      "summary": "Use a tighter fan-out limit for large modules."
    },
    {
      "id": "MYPY.SETTING.exclude",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "(^tests/fixtures/test_codebase/|^docs/|^images/|^systems/claude-code/)"
      },
      "summary": "Preserve or deliberately adapt mypy setting exclude."
    },
    {
      "id": "MYPY.SETTING.mypy_path",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "shared:tools/enaible/src"
      },
      "summary": "Preserve or deliberately adapt mypy setting mypy_path."
    },
    {
      "id": "MYPY.SETTING.python_version",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "3.12"
      },
      "summary": "Preserve or deliberately adapt mypy setting python_version."
    },
    {
      "id": "MYPY.SETTING.show_error_codes",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "True"
      },
      "summary": "Preserve or deliberately adapt mypy setting show_error_codes."
    },
    {
      "id": "MYPY.follow_imports",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "skip"
      },
      "summary": "Enforce follow_imports typing behavior or target-language equivalent."
    },
    {
      "id": "MYPY.module-overrides",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": {
          "mypy-typer": {
            "ignore_missing_imports": "True"
          },
          "mypy-yaml": {
            "ignore_missing_imports": "True"
          },
          "mypy-enaible.commands.*": {
            "disallow_untyped_decorators": "False"
          },
          "mypy-enaible.app": {
            "disallow_untyped_decorators": "False"
          }
        }
      },
      "summary": "Scope missing-import and decorator exceptions to named modules."
    },
    {
      "id": "MYPY.package-coverage",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "packages": [
          "core.base",
          "core.config",
          "core.utils",
          "core.cli",
          "analyzers",
          "context",
          "enaible"
        ]
      },
      "summary": "Type-check every maintained package and fail on package-list drift."
    },
    {
      "id": "MYPY.strict",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "True"
      },
      "summary": "Enforce strict typing behavior or target-language equivalent."
    },
    {
      "id": "MYPY.warn_unused_ignores",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "True"
      },
      "summary": "Enforce warn_unused_ignores typing behavior or target-language equivalent."
    },
    {
      "id": "PARITY.dependency-inventory",
      "kind": "process",
      "applicability": "conditional",
      "contract": {
        "declared_analyzer_dependencies_match_install": true
      },
      "summary": "Fail when declared optional analyzer dependencies and installation behavior drift."
    },
    {
      "id": "PARITY.install-guidance",
      "kind": "process",
      "applicability": "conditional",
      "contract": {},
      "summary": "Keep documented install commands aligned with the actual installer."
    },
    {
      "id": "PARITY.lock-version",
      "kind": "process",
      "applicability": "conditional",
      "contract": {
        "tracked_lockfile": true,
        "version_sync": true
      },
      "summary": "Fail when package metadata and lockfile versions drift."
    },
    {
      "id": "PRETTIER.version",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "version": "3.6.2",
        "tracked_markdown_yaml": true
      },
      "summary": "Pin and invoke Prettier for maintained Markdown and YAML."
    },
    {
      "id": "PYQ100",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "target_maintained_roots_required": true
      },
      "summary": "Maintained Python source roots"
    },
    {
      "id": "PYQ101",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "target_script_name_allowlist_required": true,
        "kebab_case_for_command_scripts": true
      },
      "summary": "Approved script file naming and allowlist"
    },
    {
      "id": "PYQ102",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "canonical_test_groups": [
          "fixtures",
          "integration",
          "seams",
          "support",
          "unit"
        ],
        "target_must_map_groups": true
      },
      "summary": "Canonical test directory groups"
    },
    {
      "id": "PYQ103",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "restricted_name_parts": ["common", "helpers", "misc", "stuff", "temp"],
        "target_allowlist_required": true
      },
      "summary": "No unapproved generic directory names"
    },
    {
      "id": "PYQ104",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "restricted_name_parts": ["common", "helpers", "misc", "stuff", "temp"],
        "target_allowlist_required": true
      },
      "summary": "No unapproved generic module names"
    },
    {
      "id": "PYQ105",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "style": "snake_case"
      },
      "summary": "Python package directories use snake_case"
    },
    {
      "id": "PYQ106",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "style": "kebab-case"
      },
      "summary": "Skill directories use kebab-case"
    },
    {
      "id": "PYQ107",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "style": "snake_case"
      },
      "summary": "Python module names use snake_case"
    },
    {
      "id": "PYQ200",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "max_lines": 700
      },
      "summary": "Class length at most 700 lines"
    },
    {
      "id": "PYQ202",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "max_parameters": 8
      },
      "summary": "Constructor parameters at most 8"
    },
    {
      "id": "PYQ203",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "max_attributes": 12
      },
      "summary": "Instance attributes at most 12"
    },
    {
      "id": "PYQ210",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "approved_base_or_mixin_required": true
      },
      "summary": "Analyzer classes inherit an approved analyzer base or mixin"
    },
    {
      "id": "PYQ211",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "project_entrypoint_required": true
      },
      "summary": "Project analyzers implement the project entrypoint"
    },
    {
      "id": "PYQ220",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "approved_subprocess_wrapper_map_required": true
      },
      "summary": "Subprocess calls stay in approved seam wrappers"
    },
    {
      "id": "PYQ221",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "dynamic_import_adapter_allowlist_required": true
      },
      "summary": "Dynamic imports stay in adapter modules"
    },
    {
      "id": "PYQ230",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "named_callable_aliases_required": true
      },
      "summary": "Contract callables use named aliases"
    },
    {
      "id": "PYQ231",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "prohibit_any_collaborator_boundary": true
      },
      "summary": "Collaborator contracts do not use Any"
    },
    {
      "id": "PYQ299",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "parse_error_is_failure": true
      },
      "summary": "Undecodable source fails closed"
    },
    {
      "id": "PYS000",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "parse_error_is_failure": true
      },
      "summary": "Unparsable source fails closed"
    },
    {
      "id": "PYS250",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "max_loop_depth": 2
      },
      "summary": "Nested loop and comprehension depth at most 2"
    },
    {
      "id": "PYS251",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "scope": "analyzer_like_code",
        "approved_seam_required": true
      },
      "summary": "No synchronous filesystem I/O in analyzer-like code"
    },
    {
      "id": "PYS252",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "scope": "analyzer_like_code",
        "approved_seam_required": true
      },
      "summary": "No direct subprocess or environment access in analyzer-like code"
    },
    {
      "id": "PYS253",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "scope": "analyzer_like_code",
        "ownership_marker_required": true
      },
      "summary": "Analyzer-like subsystem has an ownership marker"
    },
    {
      "id": "RUFF.FORMAT.docstring-code-format",
