    },
    {
      "id": "RUFF.IGNORES",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "ignore": [
          "E501",
          "D100",
          "D101",
          "D102",
          "D103",
          "D104",
          "D105",
          "D107",
          "B006",
          "B008",
          "A005"
        ],
        "per_file": {
          "__init__.py": ["F401", "F403", "D104"],
          "test_*.py": ["D", "S101", "PLR2004"],
          "**/tests/**": ["D", "S101", "PLR2004"],
          "conftest.py": ["D"],
          "setup.py": ["D"]
        }
      },
      "summary": "Carry only justified lint exceptions; detect added suppressions."
    },
    {
      "id": "RUFF.ISORT.combine-as-imports",
